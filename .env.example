# Planit Data Library — Environment Configuration
# When NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY are omitted,
# the application runs with local persistent storage and built-in Next.js Edge API routes.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_ALLOWED_GOOGLE_DOMAINS=planit.studio,planit-inc.com,gmail.com
AUTH_SECRET=
EDGE_AI_MODEL=claude-3-5-haiku-latest
